{
  "name": "@vitest/calculator-test",
  "version": "1.0.0",
  "description": "Ein einfacher Taschenrechner für eine Testing-Präsentation (Vitest)",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "./node_modules/.bin/vitest",
    "test:ui": "./node_modules/.bin/vitest --ui",
    "test:run": "./node_modules/.bin/vitest run",
    "coverage": "./node_modules/.bin/vitest run --coverage"
  },
  "keywords": [
    "typescript",
    "demo",
    "testing"
  ],
  "author": "Leonard Siesing",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@vitest/ui": "latest",
    "typescript": "^5.4.5",
    "vite": "latest",
    "vitest": "^4.0.5"
  }
}
